{
  "luci-app-nova-dashboard": {
    "description": "Read-only Nova dashboard device, interface, Wi-Fi and rate statistics",
    "read": {
      "file": {
        "/proc/stat": [
          "read"
        ],
        "/sys/class/thermal/thermal_zone*/temp": [
          "read"
        ]
      },
      "ubus": {
        "system": [
          "board",
          "info"
        ],
        "network.interface": [
          "dump"
        ],
        "luci": [
          "getRealtimeStats"
        ],
        "luci-rpc": [
          "getNetworkDevices",
          "getWirelessDevices",
          "getHostHints",
          "getBoardJSON"
        ],
        "iwinfo": [
          "assoclist"
        ],
        "file": [
          "read"
        ]
      },
      "uci": [
        "network",
        "wireless",
        "luci"
      ]
    }
  }
}
